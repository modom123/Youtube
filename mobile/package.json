{
  "name": "social-optimize-mobile",
  "version": "1.0.0",
  "description": "Social Optimize Android app (Capacitor wrapper)",
  "scripts": {
    "build": "echo 'No build step needed — static www/'",
    "cap:init": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "cap:release": "npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "keywords": [],
  "author": "Social Optimize",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
