# ============================================================
# Social Optimize Machine - Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================================

# ── App ───────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_stable_secret_key_here
APP_BASE_URL=http://localhost:5000

# ── Stripe (Payments) ─────────────────────────────────────
# Get from dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Create products + prices in Stripe, paste the Price IDs:
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_AGENCY=price_...

# ── Anthropic (Claude AI) ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Pexels (Stock Video & Images) ─────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ── Google Flow / Veo 2 ────────────────────────────────────
# Get from Google AI Studio: aistudio.google.com → API Keys
GOOGLE_API_KEY=your_google_api_key_here

# ── Higgsfield AI ──────────────────────────────────────────
# Get from higgsfield.ai → Dashboard → API Keys
# Format: "api_key:api_secret" (combined) OR set HF_API_KEY + HF_API_SECRET
HIGGSFIELD_API_KEY=your_higgsfield_key:your_higgsfield_secret
# MCP bearer token for https://mcp.higgsfield.ai/mcp
# If left blank, the key portion of HIGGSFIELD_API_KEY is used automatically.
HIGGSFIELD_MCP_TOKEN=

# ── YouTube ───────────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080

# ── TikTok ────────────────────────────────────────────────
# Get from TikTok for Developers → App dashboard
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ── Instagram / Facebook ──────────────────────────────────
# Get from Meta for Developers → App dashboard
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ── Default Content Settings ──────────────────────────────
DEFAULT_LANGUAGE=en-US
DEFAULT_VOICE=en-US-AriaNeural
DEFAULT_VIDEO_WIDTH=1920
DEFAULT_VIDEO_HEIGHT=1080
SHORT_VIDEO_WIDTH=1080
SHORT_VIDEO_HEIGHT=1920
OUTPUT_DIR=./output
