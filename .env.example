# ============================================================
# Social Optimize Machine — Environment Configuration
# Domain: socialoptimize.online
# Copy this file to .env and fill in your credentials
# ============================================================

# ── App ───────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_stable_secret_key_here
# Your public URL (Render sets this automatically via render.yaml)
APP_BASE_URL=https://socialoptimize.online
# Persistent data directory — leave blank for local dev (uses project root)
# On Render this is set to /data automatically via render.yaml
DATA_DIR=

# ── Stripe (Payments) ─────────────────────────────────────
# Get from dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Create products + prices in Stripe, paste the Price IDs:
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_AGENCY=price_...

# ── Anthropic (Claude AI) ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Pexels (Stock Video & Images) ─────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ── Google APIs (TTS Neural2, Translate, Vision, NLP, Trends, Flow/Veo) ──────
# Get from Google AI Studio: aistudio.google.com → API Keys
# Enables: Cloud TTS Neural2 (HD audio), Cloud Translation, Cloud Vision,
#          Cloud Natural Language, Gemini Flash research & scripting, Veo 2
GOOGLE_API_KEY=your_google_api_key_here
# Google Cloud TTS voice (default: en-US-Neural2-C female US)
GOOGLE_TTS_VOICE=en-US-Neural2-C

# ── ElevenLabs (AI Voiceovers — primary voice source for every studio) ──
# Get from elevenlabs.io → Profile → API Keys. Without this key the app falls
# back to Google/edge TTS (and finally espeak), so set it for premium voices.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Synthesis model. "eleven_multilingual_v2" = highest quality (default);
# "eleven_turbo_v2_5" = faster/cheaper.
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Freesound (Sound Library) ─────────────────────────────
# Get from freesound.org → Apply for API credentials
FREESOUND_API_KEY=your_freesound_api_key_here

# ── Higgsfield AI ──────────────────────────────────────────
# Higgsfield has TWO separate auth systems — use ONE:
#
# 1) MCP endpoint (mcp.higgsfield.ai) — OAuth bearer token. This is what the
#    in-app studios (incl. Image Studio) call. Preferred: connect per-user via
#    the Accounts page ("Connect Higgsfield", OAuth — nothing to paste). The env
#    var below is a global fallback. Paste the token, NOT the endpoint URL.
HIGGSFIELD_MCP_TOKEN=your_higgsfield_mcp_token_here
#
# 2) Platform API (platform.higgsfield.ai) — a KEY_ID + KEY_SECRET pair, used by
#    the higgsfield-client SDK/CLI (Authorization: Key KEY_ID:KEY_SECRET). Set
#    BOTH if you have Platform API credentials instead of an MCP/OAuth token.
HIGGSFIELD_API_KEY=your_higgsfield_key_id
HIGGSFIELD_API_SECRET=your_higgsfield_key_secret

# ── Whop (free clipper product + embedded app) ────────────
# Create an App in the Whop dashboard (Developer → Apps), attach it to your
# product, and set its App/Experience path to <APP_BASE_URL>/whop/experiences/:experienceId
# WHOP_API_KEY       — company API key: setup, stats, membership admin
# WHOP_APP_API_KEY   — app API key: member-facing iframe/experience validation
# WHOP_WEBHOOK_SECRET— signing secret to verify /whop/webhook payloads
# WHOP_COMPANY_ID    — your Whop company/biz id
WHOP_API_KEY=your_whop_company_api_key
WHOP_APP_API_KEY=your_whop_app_api_key
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret
WHOP_COMPANY_ID=your_whop_company_id

# ── YouTube ───────────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=https://socialoptimize.online/oauth/youtube/callback

# ── TikTok ────────────────────────────────────────────────
# Get from TikTok for Developers → App dashboard
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ── Instagram / Threads ───────────────────────────────────
# Get from Meta for Developers → App dashboard
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
# Threads uses the same token/account as Instagram (no extra vars needed)

# ── Facebook ──────────────────────────────────────────────
# Get a long-lived Page access token from Meta for Developers
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_access_token

# ── Twitter / X ───────────────────────────────────────────
# Get from developer.twitter.com → App → Keys and Tokens
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ── LinkedIn ──────────────────────────────────────────────
# Get from linkedin.com/developers → App → Auth
# Person ID is the urn:li:person:XXXX ID (found via OAuth token introspection)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_ID=your_linkedin_person_id

# ── Pinterest ─────────────────────────────────────────────
# Get from developers.pinterest.com → App → Auth
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_BOARD_ID=your_pinterest_board_id

# ── Email Notifications (optional) ────────────────────────
# If not set, email notifications are silently skipped.
# Works with any SMTP provider (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@socialoptimize.online

# ── Default Content Settings ──────────────────────────────
DEFAULT_LANGUAGE=en-US
DEFAULT_VOICE=en-US-AriaNeural
DEFAULT_VIDEO_WIDTH=1920
DEFAULT_VIDEO_HEIGHT=1080
SHORT_VIDEO_WIDTH=1080
SHORT_VIDEO_HEIGHT=1920
